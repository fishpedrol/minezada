{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "ground",
            "fixed",
            "on_shelf"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "cultivo:item/bong"
          }
        },
        {
          "when": [
            "firstperson_righthand",
            "firstperson_lefthand"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "cultivo:item/bong_in_hand_lit"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "entries": [
          {
            "threshold": 0,
            "model": {
              "type": "minecraft:model",
              "model": "cultivo:item/bong_in_hand_lit_k0"
            }
          },
          {
            "threshold": 1,
            "model": {
              "type": "minecraft:model",
              "model": "cultivo:item/bong_in_hand_lit_k1"
            }
          },
          {
            "threshold": 2,
            "model": {
              "type": "minecraft:model",
              "model": "cultivo:item/bong_in_hand_lit_k2"
            }
          },
          {
            "threshold": 3,
            "model": {
              "type": "minecraft:model",
              "model": "cultivo:item/bong_in_hand_lit_k3"
            }
          },
          {
            "threshold": 4,
            "model": {
              "type": "minecraft:model",
              "model": "cultivo:item/bong_in_hand_lit_k4"
            }
          },
          {
            "threshold": 5,
            "model": {
              "type": "minecraft:range_dispatch",
              "property": "minecraft:use_duration",
              "remaining": true,
              "entries": [
                {
                  "threshold": 1,
                  "model": {
                    "type": "minecraft:model",
                    "model": "cultivo:item/bong_in_hand_lit_k1"
                  }
                },
                {
                  "threshold": 2,
                  "model": {
                    "type": "minecraft:model",
                    "model": "cultivo:item/bong_in_hand_lit_k2"
                  }
                },
                {
                  "threshold": 3,
                  "model": {
                    "type": "minecraft:model",
                    "model": "cultivo:item/bong_in_hand_lit_k3"
                  }
                },
                {
                  "threshold": 4,
                  "model": {
                    "type": "minecraft:model",
                    "model": "cultivo:item/bong_in_hand_lit_k4"
                  }
                },
                {
                  "threshold": 5,
                  "model": {
                    "type": "minecraft:model",
                    "model": "cultivo:item/bong_in_hand_lit"
                  }
                }
              ],
              "fallback": {
                "type": "minecraft:model",
                "model": "cultivo:item/bong_in_hand_lit_k0"
              }
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "cultivo:item/bong_in_hand_lit_k0"
        }
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "ground",
            "fixed",
            "on_shelf"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "cultivo:item/bong"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "cultivo:item/bong_in_hand"
      }
    }
  }
}
